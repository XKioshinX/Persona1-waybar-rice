{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": [
        "custom/butterfly",
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "memory",
        "cpu",
        "battery",
        "tray"
    ],

    "custom/butterfly": {
        "format": "🦋 I",
        "tooltip": true,
        "tooltip-format": "BE YOUR TRUE MIND — St. Hermelin High"
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "default": "•"
        }
    },

    "niri/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "(.*) - Mozilla Firefox": "󰈹 $1",
            "(.*) - Cromite": "󰖟 $1",
            "(.*) - foot": " $1"
        }
    },

    "clock": {
        "format": "󰥔 {:%H:%M  |  %a %d %b}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#9d4edd'><b>{}</b></span>",
                "days": "<span color='#e0d7ff'>{}</span>",
                "today": "<span color='#ffb703'><b><u>{}</u></b></span>"
            }
        }
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 MUTE",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {used:0.1f}G",
        "tooltip-format": "RAM: {used:0.2f} GiB / {total:0.2f} GiB ({percentage}%)"
    },

    "cpu": {
        "interval": 3,
        "format": "󰻠 {usage}%"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 12
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    }
}
